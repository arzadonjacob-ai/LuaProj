Guessing Game
]]

math.randomseed(os.time())
won = false
answer = "yes"

while answer == "yes" do

randomNum = math.random(1, 100)

  for i = 1, 7 do

    print("Enter your guess: ")
    guess = tonumber(io.read())

    while guess == nil do
      print("Please enter a valid number: ")
      guess = tonumber(io.read())
    end

    if guess == randomNum then
      print("You win! You guessed the number in " .. i .. " attempt(s)!")
      won = true
      break
    end
  end
  if not won then
    print("You lose! The number was " .. randomNum .. ".")
  end

  print("Would you like to play again? (yes/no): ")
  answer = io.read()
  while answer ~= "yes" and answer ~= "no" do
    print("Please enter 'yes' or 'no': ")
    answer = io.read()
  end
end
